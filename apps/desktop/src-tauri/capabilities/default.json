{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-set-title"
  ]
}
